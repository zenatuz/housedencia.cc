# Custom CNAME records for dnsmasq (Pi-hole's DNS service)
# Format: cname=alias.domain,original.domain
# Example: cname=www.example.com,example.com
# This file is mounted at /etc/dnsmasq.d/05-pihole-custom-cname.conf

# Home network service mappings
cname=pihole.housedencia.cc,vm-docker-minipc.housedencia.cc
cname=torrent.housedencia.cc,vm-docker-minipc.housedencia.cc
cname=vpn.housedencia.cc,vm-docker-minipc.housedencia.cc
cname=prowlarr.housedencia.cc,vm-docker-minipc.housedencia.cc
cname=sonarr.housedencia.cc,vm-docker-minipc.housedencia.cc
cname=radarr.housedencia.cc,vm-docker-minipc.housedencia.cc
cname=player.housedencia.cc,vm-docker-minipc.housedencia.cc
cname=smb-share.housedencia.cc,vm-docker-minipc.housedencia.cc
