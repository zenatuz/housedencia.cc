# Custom CNAME records for dnsmasq (Pi-hole's DNS service)
# Format: cname=alias.domain,original.domain
# Example: cname=www.example.com,example.com
# This file is mounted at /etc/dnsmasq.d/05-pihole-custom-cname.conf

# Home network service mappings
cname=pihole01.housedencia.cc,proxy.housedencia.cc
cname=pihole02.housedencia.cc,docker01.housedencia.cc
cname=proxmox.housedencia.cc,proxy.housedencia.cc
cname=code.housedencia.cc,proxy.housedencia.cc
cname=plex.housedencia.cc,proxy.housedencia.cc
cname=jackett.housedencia.cc,proxy.housedencia.cc
cname=sonarr.housedencia.cc,proxy.housedencia.cc
cname=radarr.housedencia.cc,proxy.housedencia.cc
